# Environment variables for EnterpriseApps service (systemd EnvironmentFile)

# Application
APP_PORT=8080
APP_ALLOWED_ORIGINS=*
OPEN_IN_VIEW=false
SHOW_SQL=false
FORMAT_SQL=false
SERVICE_TIMEOUT=60

# Database (PostgreSQL)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=enterpriseapps
DB_USERNAME=enterpriseapps
DB_PASSWORD=changeMe
DB_SCHEMA=public
DB_HIKARI_MAXIMUM_POOL_SIZE=30
DB_HIKARI_MINIMUM_IDLE=10
DB_HIKARI_IDLE_TIMEOUT=600000
DB_HIKARI_MAX_LIFETIME=1800000
DB_HIKARI_CONNECTION_TIMEOUT=30000
DB_HIKARI_POOL_NAME=ENTERPRISEAPPS-POOL
DB_HIKARI_LEAK_DETECTION_THRESHOLD=20000
DB_HIKARI_VALIDATION_TIMEOUT=5000

# External services
APLICARES_TOKEM=IniDummyToken
DATA_FASKES_URL=https://faskes.bpjs-kesehatan.go.id/aplicares/Peta/getData

