#!/usr/bin/env bash
# =============================================================
# baik-deploy — git pull + build + restart, langsung di server.
#
#   baik-deploy backend    JAR backend + gateway  -> systemd backend, gateway
#   baik-deploy frontend   React (Vite) build     -> /var/www/html/frontend
#   baik-deploy rag        image Docker           -> container irms-rag
#   baik-deploy smartdocs-ocr  image Docker       -> container irms-smartdocs-ocr
#   baik-deploy all        keempatnya
#
# Kode diambil dari klon git di /home/administrator (remote: GitHub).
# Artefak lama di-backup dulu, dan setiap service dicek health-nya
# setelah restart — kalau gagal, backend/gateway di-rollback otomatis.
# =============================================================
set -euo pipefail

SRC=/home/administrator
APP_DIR=/var/www/app-backend
WEB_DIR=/var/www/html/frontend
BACKUP_DIR=/var/backups/baik-deploy
JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64
export JAVA_HOME

log()  { printf '\n\033[1;34m==> %s\033[0m\n' "$*"; }
ok()   { printf '\033[1;32m  ✓ %s\033[0m\n' "$*"; }
die()  { printf '\033[1;31m  ✗ %s\033[0m\n' "$*" >&2; exit 1; }

need_root() { [ "$(id -u)" -eq 0 ] || die "jalankan dengan sudo: sudo baik-deploy $*"; }

# git pull sebagai user administrator (pemilik klon + SSH key), bukan root.
pull() {
  local repo="$1"
  log "git pull $repo"
  sudo -u administrator git -C "$SRC/$repo" pull --ff-only origin main
  ok "$(sudo -u administrator git -C "$SRC/$repo" log --oneline -1)"
}

# Tunggu sampai HTTP endpoint balas, timeout N detik.
wait_http() {
  local url="$1" timeout="${2:-90}" i=0
  while [ "$i" -lt "$timeout" ]; do
    # 2xx/3xx/4xx = service hidup (401/400 tetap berarti sudah listen)
    curl -s -o /dev/null -m 3 "$url" && return 0
    i=$((i + 3)); sleep 3
  done
  return 1
}

deploy_backend() {
  pull enterprise-apps-services
  mkdir -p "$BACKUP_DIR"

  log "build JAR (backend + gateway)"
  cd "$SRC/enterprise-apps-services"
  # `sh ./gradlew`, bukan `./gradlew`: checkout dari Windows kadang kehilangan exec bit.
  sudo -u administrator env JAVA_HOME="$JAVA_HOME" sh ./gradlew bootJar :gateway:bootJar -x test --no-daemon -q \
    || die "build gagal — service lama TETAP JALAN, tidak ada yang diubah"
  ok "build sukses"

  local new_backend="$SRC/enterprise-apps-services/build/libs/irms-0.0.1-SNAPSHOT.jar"
  local new_gateway="$SRC/enterprise-apps-services/gateway/build/libs/irms-gateway.jar"
  [ -f "$new_backend" ] && [ -f "$new_gateway" ] || die "JAR hasil build tidak ditemukan"

  log "backup artefak lama"
  cp "$APP_DIR/app-backend.jar"  "$BACKUP_DIR/app-backend.jar.prev"
  cp "$APP_DIR/irms-gateway.jar" "$BACKUP_DIR/irms-gateway.jar.prev"
  ok "tersimpan di $BACKUP_DIR"

  log "pasang JAR baru + restart"
  install -o springuser -g springuser -m 644 "$new_backend" "$APP_DIR/app-backend.jar"
  install -o springuser -g springuser -m 644 "$new_gateway" "$APP_DIR/irms-gateway.jar"
  systemctl restart backend gateway

  log "health check"
  if wait_http http://127.0.0.1:8082/api/v1/auth/login 120 && wait_http http://127.0.0.1:8080/api/v1/auth/login 60; then
    ok "backend :8082 dan gateway :8080 merespons"
  else
    printf '\033[1;31m  ✗ health check GAGAL — rollback ke versi sebelumnya\033[0m\n' >&2
    install -o springuser -g springuser -m 644 "$BACKUP_DIR/app-backend.jar.prev"  "$APP_DIR/app-backend.jar"
    install -o springuser -g springuser -m 644 "$BACKUP_DIR/irms-gateway.jar.prev" "$APP_DIR/irms-gateway.jar"
    systemctl restart backend gateway
    die "sudah dikembalikan ke versi lama. Cek: journalctl -u backend -n 50"
  fi
}

deploy_frontend() {
  pull enterprise-apps-ui

  log "npm ci && npm run build"
  cd "$SRC/enterprise-apps-ui"
  sudo -u administrator npm ci --silent || die "npm ci gagal"
  sudo -u administrator npm run build || die "build gagal — frontend lama TETAP TAYANG"
  [ -d dist ] || die "folder dist/ tidak dihasilkan"
  ok "build sukses"

  log "backup + pasang"
  mkdir -p "$BACKUP_DIR"
  rm -rf "$BACKUP_DIR/frontend.prev"
  cp -r "$WEB_DIR" "$BACKUP_DIR/frontend.prev"
  rm -rf "${WEB_DIR:?}"/*
  cp -r dist/. "$WEB_DIR/"
  chown -R www-data:www-data "$WEB_DIR"
  chmod -R 755 "$WEB_DIR"

  wait_http http://127.0.0.1/ 20 && ok "frontend tayang di :80" || die "nginx tidak merespons"
}

deploy_rag() {
  pull rag-chatbot

  log "sinkron source ke /var/www/rag-service"
  rsync -a --delete --exclude uploads --exclude .git "$SRC/rag-chatbot/" /var/www/rag-service/
  chown -R raguser:raguser /var/www/rag-service

  log "build image Docker"
  cd /var/www/rag-service
  docker build -q -t rag-chatbot:new . >/dev/null || die "docker build gagal — container lama TETAP JALAN"
  ok "image ter-build"

  log "swap container"
  docker tag rag-chatbot:latest rag-chatbot:prev 2>/dev/null || true
  docker tag rag-chatbot:new rag-chatbot:latest
  docker rm -f irms-rag >/dev/null 2>&1 || true
  docker run -d --name irms-rag --network=host \
    --env-file /etc/rag.env \
    -v /var/www/rag-service/uploads:/app/uploads \
    --restart unless-stopped rag-chatbot:latest >/dev/null

  log "health check"
  if wait_http http://127.0.0.1:8000/api/v1/health 60; then
    ok "RAG :8000 healthy"
    docker image rm rag-chatbot:new >/dev/null 2>&1 || true
  else
    printf '\033[1;31m  ✗ health check GAGAL — rollback ke image sebelumnya\033[0m\n' >&2
    docker rm -f irms-rag >/dev/null 2>&1 || true
    docker tag rag-chatbot:prev rag-chatbot:latest
    docker run -d --name irms-rag --network=host \
      --env-file /etc/rag.env \
      -v /var/www/rag-service/uploads:/app/uploads \
      --restart unless-stopped rag-chatbot:latest >/dev/null
    die "sudah dikembalikan ke image lama. Cek: docker logs irms-rag"
  fi
}

deploy_smartdocs_ocr() {
  pull enterprise-apps-services

  log "build image Docker (SmartDocs OCR)"
  cd "$SRC/enterprise-apps-services/smartdocs-ocr"
  docker build -q -t smartdocs-ocr:new . >/dev/null || die "docker build gagal — container lama TETAP JALAN"
  ok "image ter-build"

  # Env opsional: service jalan dengan default yang aman tanpa berkas ini.
  local envarg=""
  [ -f /etc/smartdocs-ocr.env ] && envarg="--env-file /etc/smartdocs-ocr.env"

  log "swap container"
  docker tag smartdocs-ocr:latest smartdocs-ocr:prev 2>/dev/null || true
  docker tag smartdocs-ocr:new smartdocs-ocr:latest
  docker rm -f irms-smartdocs-ocr >/dev/null 2>&1 || true
  # Volume model WAJIB dipasang: tanpa itu container baru mengunduh ulang
  # beberapa GB model PaddleOCR pada pemindaian pertama.
  docker run -d --name irms-smartdocs-ocr --network=host $envarg \
    -v smartdocs_models:/app/.model-cache \
    -v smartdocs_files:/app/document-files \
    --restart unless-stopped smartdocs-ocr:latest >/dev/null

  log "health check"
  if wait_http http://127.0.0.1:8001/health 60; then
    ok "SmartDocs OCR :8001 healthy"
    docker image rm smartdocs-ocr:new >/dev/null 2>&1 || true
  else
    printf '\033[1;31m  ✗ health check GAGAL — rollback ke image sebelumnya\033[0m\n' >&2
    docker rm -f irms-smartdocs-ocr >/dev/null 2>&1 || true
    docker tag smartdocs-ocr:prev smartdocs-ocr:latest
    docker run -d --name irms-smartdocs-ocr --network=host $envarg \
      -v smartdocs_models:/app/.model-cache \
      -v smartdocs_files:/app/document-files \
      --restart unless-stopped smartdocs-ocr:latest >/dev/null
    die "sudah dikembalikan ke image lama. Cek: docker logs irms-smartdocs-ocr"
  fi
}

status() {
  log "status service"
  systemctl is-active backend gateway nginx postgresql redis-server kafka \
    | paste -d' ' <(printf 'backend\ngateway\nnginx\npostgresql\nredis\nkafka\n') -
  # RAG lewat HTTP, bukan `docker inspect` (butuh root — status bisa dijalankan user biasa).
  if curl -sf -m 3 http://127.0.0.1:8000/api/v1/health >/dev/null; then
    printf 'rag healthy\n'
  else
    printf 'rag TIDAK MERESPONS\n'
  fi
  if curl -sf -m 3 http://127.0.0.1:8001/health >/dev/null; then
    printf 'smartdocs-ocr healthy\n'
  else
    printf 'smartdocs-ocr TIDAK MERESPONS\n'
  fi
}

case "${1:-}" in
  backend)  need_root "$@"; deploy_backend; status ;;
  frontend) need_root "$@"; deploy_frontend; status ;;
  rag)      need_root "$@"; deploy_rag; status ;;
  smartdocs-ocr) need_root "$@"; deploy_smartdocs_ocr; status ;;
  all)      need_root "$@"; deploy_backend; deploy_frontend; deploy_rag; deploy_smartdocs_ocr; status ;;
  status)   status ;;
  *)
    cat <<EOF
baik-deploy — git pull + build + restart

  sudo baik-deploy backend     backend + gateway (Spring Boot)
  sudo baik-deploy frontend    React SPA
  sudo baik-deploy rag         RAG chatbot (Docker)
  sudo baik-deploy smartdocs-ocr  mesin OCR SmartDocs (Docker)
  sudo baik-deploy all         keempatnya
       baik-deploy status      cek service saja

Build gagal = service lama tetap jalan. Health check gagal setelah
restart = otomatis rollback ke versi sebelumnya.
EOF
    exit 1 ;;
esac

log "SELESAI"
