# Backend API URL (leave empty to use Vite proxy)
VITE_API_URL=

# Firebase Cloud Messaging VAPID key (from Firebase Console → Project Settings → Cloud Messaging → Web Push certificates)
VITE_FIREBASE_VAPID_KEY=

# Note: the EnterpriseAI widget (chat AI global) no longer needs a frontend key —
# it calls the Spring backend proxy (/api/v1/assistant/chat), which holds the
# Gemini key server-side. Set GEMINI_API_KEY in the backend's environment instead.
